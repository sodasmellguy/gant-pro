{
  "name": "@gantt-pro/core",
  "version": "1.1.3",
  "description": "跨框架甘特图核心逻辑层（零框架依赖）",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --fix",
    "lint:check": "eslint src",
    "format": "prettier --write \"src/**/*.{ts,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,json}\""
  },
  "keywords": [
    "gantt",
    "gantt-chart",
    "core",
    "framework-agnostic",
    "project-management",
    "timeline",
    "scheduler",
    "critical-path",
    "甘特图"
  ],
  "license": "MIT",
  "author": "gantt-pro",
  "homepage": "https://www.sodasmell.top",
  "repository": {
    "type": "git",
    "url": "https://github.com/sodasmellguy/gant-pro"
  },
  "bugs": {
    "url": "https://github.com/sodasmellguy/gant-pro/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "tsup": "^8.0.0",
    "typescript": "~5.7.2",
    "vitest": "^4.1.11"
  }
}
