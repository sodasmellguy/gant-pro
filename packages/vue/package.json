{
  "name": "@gantt-pro/vue",
  "version": "1.1.4",
  "description": "跨框架甘特图 Vue 3 适配层",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./dist/gantt.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "vite build --config vite.lib.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --fix",
    "lint:check": "eslint src",
    "format": "prettier --write \"src/**/*.{ts,vue,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,vue,css,json}\""
  },
  "keywords": [
    "vue",
    "vue3",
    "gantt",
    "gantt-chart",
    "甘特图",
    "timeline",
    "scheduler",
    "project-management",
    "critical-path",
    "dependency"
  ],
  "license": "MIT",
  "author": "gantt-pro",
  "homepage": "https://www.sodasmell.top",
  "repository": {
    "type": "git",
    "url": "https://github.com/sodasmellguy/gant-pro"
  },
  "bugs": {
    "url": "https://github.com/sodasmellguy/gant-pro/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "@gantt-pro/core": "^1.1.0",
    "vue": "^3.2.0"
  },
  "devDependencies": {
    "@gantt-pro/core": "workspace:*",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/language-core": "^3.3.11",
    "@vue/test-utils": "^2.5.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-vue": "^9.33.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "tsup": "^8.0.0",
    "typescript": "~5.7.2",
    "vite": "^6.3.5",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.1.11",
    "vue": "^3.5.13"
  }
}
